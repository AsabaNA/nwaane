EMAIL=owner@local.test
# use a long passphrase (12+ characters); production refuses shorter ones
PASSWORD=change-me-to-a-long-passphrase
# in production: NODE_ENV=production, and behind a proxy/Cloudflare: TRUST_PROXY=1
# email (Resend). Without a key, codes and links are printed in the server console (development only; production refuses to run sign-in without it)
RESEND_API_KEY=
MAIL_FROM=School Platform <onboarding@resend.dev>
# public address used in emailed reset links (default: the address the request came to)
BASE_URL=

# AI assistant (paid Gemini key). Leave empty to keep the assistant unavailable.
GEMINI_API_KEY=
